{
  "name": "lumen-aurora",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "A cinematic, privacy-first new tab with search, shortcuts, weather, focus, notes, and Spotify.",
  "license": "MIT",
  "author": "Aditya (DragAditya)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DragAditya/HomeExtension.git"
  },
  "homepage": "https://github.com/DragAditya/HomeExtension#readme",
  "bugs": {
    "url": "https://github.com/DragAditya/HomeExtension/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/prepare-source.mjs && vite",
    "build": "node scripts/prepare-source.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
